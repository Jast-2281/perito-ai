{
  "name": "perito-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run check:trampas && npm run check:cobertura && npm run check:extraccion && npm run check:integracion && npm run check:mutantes",
    "check:trampas": "node --experimental-strip-types scripts/check-trampas.ts --estricto",
    "check:mutantes": "node --experimental-strip-types scripts/check-mutantes.ts",
    "exportar": "node --experimental-strip-types scripts/exportar-estatico.ts perito-ai.html",
    "check:cobertura": "node --experimental-strip-types scripts/check-cobertura.ts",
    "check:extraccion": "node --experimental-strip-types scripts/check-extraccion.ts",
    "check:integracion": "node --experimental-strip-types scripts/check-integracion.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.8",
    "typescript": "5.7.2"
  }
}
